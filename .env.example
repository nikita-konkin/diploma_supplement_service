# Optional settings for docker compose. Copy to .env and change what you need;
# without .env the defaults below are used. .env is not stored in git (B-17).

# Largest accepted upload request, megabytes.
MAX_UPLOAD_MB=20

# Attestation reports at /attestation (python-attestation-engine).
# Site login for the page; the RITM portal login is asked on the page itself.
ATTESTATION_USERNAME=admin
# Hash of the site password, never the password itself. Make it with
#   docker compose run --rm --no-deps python-attestation-engine python tools/hash_password.py
# and paste the printed line here, single quotes included. Empty: nobody can log in.
ATTESTATION_PASSWORD_HASH=
# Session cookie only over HTTPS. 0 only for plain-HTTP testing away from localhost.
ATTESTATION_COOKIE_SECURE=1
# Seconds before generated reports (student names and scores) are deleted.
ATTESTATION_FILES_TTL=1800
